{
  "manifest_version": 3,
  "name": "Bidi Chat Fixer",
  "version": "1.5.0",
  "description": "Fixes mixed Arabic and English in AI chats. Idle when turned off.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bidi Chat Fixer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.chat.openai.com/*",
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://*.chat.deepseek.com/*",
    "https://deepseek.com/*",
    "https://*.deepseek.com/*",
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://*.copilot.microsoft.com/*",
    "https://perplexity.ai/*",
    "https://*.perplexity.ai/*",
    "https://poe.com/*",
    "https://*.poe.com/*",
    "https://chat.mistral.ai/*",
    "https://*.chat.mistral.ai/*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://you.com/*",
    "https://*.you.com/*",
    "https://meta.ai/*",
    "https://*.meta.ai/*",
    "https://kimi.com/*",
    "https://*.kimi.com/*",
    "https://kimi.moonshot.cn/*",
    "https://*.kimi.moonshot.cn/*",
    "https://qwen.ai/*",
    "https://*.qwen.ai/*",
    "https://tongyi.aliyun.com/*",
    "https://*.tongyi.aliyun.com/*",
    "https://character.ai/*",
    "https://*.character.ai/*",
    "https://phind.com/*",
    "https://*.phind.com/*",
    "https://openrouter.ai/*",
    "https://*.openrouter.ai/*",
    "https://chat.lmsys.org/*",
    "https://*.chat.lmsys.org/*",
    "https://copilot.cloud.microsoft/*",
    "https://*.copilot.cloud.microsoft/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
